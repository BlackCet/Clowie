# Root .gitignore for the Clowie monorepo

# Java / Spring Boot
**/target/
**/build/
**/*.class
**/*.jar
**/.mvn/wrapper/maven-wrapper.jar

# Node / frontend
**/node_modules/
**/dist/

# Environment and secret files
*.env
*.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and editor
.vscode/
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
application.properties
*.application.properties.*